{
  "id": "root",
  "type": "row",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "machine-vitals",
          "type": "block",
          "size": {
            "px": 100
          },
          "content": {
            "mod": "machine-vitals"
          }
        },
        {
          "id": "over9k",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 120,
          "content": {
            "mod": "over9k"
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "workbench-tabs",
            "props": {
              "panels": [
                { "id": "files", "label": "Files", "icon": "mods/better-files/icons/file.svg" },
                { "id": "changes", "label": "Changes", "icon": "mods/changes/changes.svg" },
                { "id": "review", "label": "Review", "icon": "mods/reviewer/comment.svg" },
                { "id": "gitlab", "label": "GitLab", "icon": "mods/gitlab/icons/gitlab.svg" },
                { "id": "graph", "label": "Graph", "icon": "mods/git-graph/icons/graph.svg" }
              ]
            }
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 0,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 1600,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "better-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "better-changes"
                      }
                    },
                    {
                      "id": "review",
                      "type": "block",
                      "content": {
                        "mod": "reviewer",
                        "props": {
                          "base": "dev"
                        }
                      }
                    },
                    {
                      "id": "gitlab",
                      "type": "block",
                      "content": {
                        "mod": "gitlab"
                      }
                    },
                    {
                      "id": "graph",
                      "type": "block",
                      "content": {
                        "mod": "git-graph",
                        "props": {
                          "base": "dev"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
